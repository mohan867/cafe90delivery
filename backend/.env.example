# ==========================================
# CAFE 90's - BACKEND ENVIRONMENT VARIABLES
# ==========================================

# 1. Environment & Port
# Set this to "production" on Render so cookies are properly secured (SameSite=None).
ENVIRONMENT=production
PORT=5000

# 2. Database
# The connection string for your Neon Postgres DB.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cafe90s

# 3. Security
# This MUST be set in production to encrypt JWTs. If you change this, everyone is logged out!
JWT_SECRET_KEY=your_secure_random_string_here

# 4. CORS (Cross-Origin Resource Sharing)
# Add your Vercel frontend URL here so the backend accepts its requests.
CORS_ORIGINS=https://cafe90delivery.vercel.app,http://localhost:5173,http://localhost:3000

# 5. Cloudinary (Required for persistent Admin Image Uploads on Render)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 6. Restaurant Location (For delivery distance calculations)
RESTAURANT_LAT=11.2447993
RESTAURANT_LNG=77.5172581
DELIVERY_RADIUS_KM=8.0